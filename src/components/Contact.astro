---
import SectionContainer from "./SectionContainer.astro";
---

<SectionContainer id="contact" title="Contáctanos">
  <div class="grid md:grid-cols-2 gap-12">
    <div class="space-y-8">
      <div>
        <h3 class="text-lg font-semibold text-foreground mb-1">Ubicación</h3>
        <p class="text-muted-foreground">
          Urb. Costa Azul Mz. A' - Lt. 6, Ilo, Perú
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-foreground mb-1">Teléfono</h3>
        <a
          href="tel:953619071"
          class="text-accent hover:text-accent/80 transition font-semibold"
        >
          953 619 071
        </a>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-foreground mb-1">Correo</h3>
        <a
          href="mailto:gjuarez@dynamic-ilo.com"
          class="text-accent hover:text-accent/80 transition font-semibold"
        >
          gjuarez@dynamic-ilo.com
        </a>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-foreground mb-">
          Redes Sociales
        </h3>
        <a
          href="https://tiktok.com/@dynamic_metalworks_ilo"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:text-accent/80 transition font-semibold"
        >
          @dynamic_metalworks_ilo
        </a>
      </div>
    </div>

    <!-- Form -->
    <div class="bg-card border border-border rounded-lg p-8 shadow-sm">
      <form id="contact-form" class="space-y-6">
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-foreground mb-2"
          >
            Nombre
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full px-4 py-2 bg-background border border-border rounded-lg text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition"
            placeholder="Tu nombre"
          />
        </div>

        <div>
          <label
            for="email"
            class="block text-sm font-medium text-foreground mb-2"
          >
            Correo
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full px-4 py-2 bg-background border border-border rounded-lg text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label
            for="message"
            class="block text-sm font-medium text-foreground mb-2"
          >
            Mensaje
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full px-4 py-2 bg-background border border-border rounded-lg text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition resize-none"
            placeholder="Cuéntanos sobre tu proyecto..."></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent/90 focus:ring-2 focus:ring-offset-2 focus:ring-accent transition cursor-pointer"
        >
          Enviar Mensaje
        </button>
      </form>
    </div>
  </div>
</SectionContainer>

<script>
  const contactForm = document.getElementById(
    "contact-form",
  ) as HTMLFormElement;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();

    const formData = {
      name: (document.getElementById("name") as HTMLInputElement)?.value,
      email: (document.getElementById("email") as HTMLInputElement)?.value,
      message: (document.getElementById("message") as HTMLTextAreaElement)
        ?.value,
    };

    console.log("Datos del formulario:", formData);
    contactForm.reset();
  });
</script>
