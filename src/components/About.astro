---
import { Image } from "astro:assets";
import industrialWorkshop from "@/assets/services/industrial-metal-workshop-with-machinery.jpg";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import SectionContainer from "@/components/SectionContainer.astro";
---

<SectionContainer id="about" title="Sobre Dynamic MetalWorks">
  <div class="grid md:grid-cols-2 gap-12 items-center">
    <Image
      src={industrialWorkshop}
      alt="Operario trabajando en taller de metal mecánica con torno industrial"
      class="relative rounded-lg w-full object-cover shadow-xl border border-border/50"
      width={600}
      height={400}
      loading="lazy"
    />

    <div class="space-y-6">
      <p class="text-lg text-muted-foreground leading-relaxed text-pretty">
        Somos <strong class="text-foreground font-medium">Dynamic</strong>, una
        organización dedicada al sector metal mecánico con una trayectoria de
        más de 20 años en el puerto de Ilo, Departamento de Moquegua, Perú.
      </p>

      <p class="text-lg text-muted-foreground leading-relaxed text-pretty">
        Nos especializamos en tornería, soldadura, mecanizado y fabricación de
        estructuras metálicas. Nuestro compromiso es ofrecer soluciones
        integrales y de alta calidad, atendiendo a la <span
          class="text-foreground">industria minera, pesquera</span
        >
        y al público en general.
      </p>

      <p class="text-lg text-muted-foreground leading-relaxed text-pretty">
        Contamos con un equipo altamente capacitado y tecnología de vanguardia
        para garantizar resultados confiables y eficientes.
      </p>

      <div class="pt-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 text-accent font-semibold hover:text-accent/80 transition group"
          aria-label="Conoce más sobre nuestra empresa y equipo"
        >
          Conoce más
          <ArrowRight
            size={20}
            class="transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </div>
</SectionContainer>
