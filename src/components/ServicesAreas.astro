---
import { coverage } from "../data";
---

<section
  id="services-areas"
  class="scroll-m-20 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"
>
  <div class="text-center mb-12">
    <h2 class="text-4xl sm:text-5xl font-bold text-foreground mb-4">
      Atendemos en
    </h2>
    <div class="h-1 w-20 bg-accent rounded-full mx-auto" aria-hidden="true">
    </div>
  </div>

  <ul class="grid grid-cols-2 md:grid-cols-4 gap-6 list-none p-0 m-0">
    {
      coverage.map((area) => (
        <li class="h-full bg-card border border-border rounded-lg p-6 text-center hover:border-accent/50 hover:bg-accent/5 transition duration-300 group cursor-default">
          <p class="text-lg font-semibold text-foreground">{area}</p>
        </li>
      ))
    }
  </ul>
</section>
