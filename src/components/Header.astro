---
import { Image } from "astro:assets";
import logo from "@/assets/logo.jpg";
import Menu from "@/components/icons/Menu.astro";
import X from "@/components/icons/X.astro";
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <nav
    class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label="Ir al inicio">
        <Image
          src={logo}
          alt="Dynamic MetalWorks"
          width={40}
          height={40}
          class="size-10 rounded-lg object-cover"
          loading="eager"
        />
        <span class="text-xl font-bold text-foreground">Dynamic</span>
      </a>

      <ul class="hidden items-center gap-8 md:flex list-none m-0 p-0">
        <li>
          <a
            href="#about"
            class="text-sm text-muted-foreground hover:text-foreground transition"
          >
            Sobre Nosotros
          </a>
        </li>
        <li>
          <a
            href="#services"
            class="text-sm text-muted-foreground hover:text-foreground transition"
          >
            Servicios
          </a>
        </li>
        <li>
          <a
            href="#contact"
            class="text-sm text-muted-foreground hover:text-foreground transition"
          >
            Contacto
          </a>
        </li>
      </ul>

      <button
        id="mobile-menu-toggle"
        class="md:hidden text-foreground"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu
          size={24}
          id="menu-icon"
          class="transition-opacity duration-200"
        />
        <X
          size={24}
          id="close-icon"
          class="hidden transition-opacity duration-200"
        />
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden pb-4 space-y-2 border-t border-border mt-2 overflow-hidden"
    >
      <ul class="flex flex-col gap-2 list-none p-0 m-0">
        <li>
          <a
            href="#about"
            class="mobile-menu-link block text-sm text-muted-foreground hover:text-foreground transition py-2"
          >
            Sobre Nosotros
          </a>
        </li>
        <li>
          <a
            href="#services"
            class="mobile-menu-link block text-sm text-muted-foreground hover:text-foreground transition py-2"
          >
            Servicios
          </a>
        </li>
        <li>
          <a
            href="#contact"
            class="mobile-menu-link block text-sm text-muted-foreground hover:text-foreground transition py-2"
          >
            Contacto
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuLinks = document.querySelectorAll(".mobile-menu-link");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  const openMenu = () => {
    mobileMenu?.classList.remove("hidden");
    menuToggle?.setAttribute("aria-expanded", "true");
    menuIcon?.classList.add("hidden");
    closeIcon?.classList.remove("hidden");
  };

  const closeMenu = () => {
    mobileMenu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
  };

  menuToggle?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.contains("hidden");
    if (isHidden) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  menuLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
